        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;plantuml\n@startuml ClassDiagram\ntitle Library Management System - Class Diagram\n\nabstract class User {\n  # userId: String\n  # name: String\n  # email: String\n  # password: String\n  + login(): boolean\n  + logout(): void\n}\n\nclass Member {\n  - membershipId: String\n  - membershipDate: Date\n  - finesOwed: double\n  + searchCatalog(query): List&lt;Book&gt;\n  + borrowBook(copy): Loan\n  + returnBook(loan): void\n  + reserveBook(book): Reservation\n  + payFine(amount): void\n}\n\nclass Librarian {\n  - employeeId: String\n  + addBook(book): void\n  + removeBook(bookId): void\n  + manageMember(member): void\n  + generateReport(type): Report\n}\n\nclass Catalog {\n  - catalogId: String\n  + addEntry(book): void\n  + removeEntry(bookId): void\n  + search(query): List&lt;Book&gt;\n}\n\nclass Book {\n  - isbn: String\n  - title: String\n  - author: String\n  - category: String\n  + getAvailability(): boolean\n}\n\nclass BookCopy {\n  - copyId: String\n  - status: String\n  + updateStatus(status): void\n}\n\nclass Loan {\n  - loanId: String\n  - issueDate: Date\n  - dueDate: Date\n  - returnDate: Date\n  + calculateFine(): double\n  + renew(): boolean\n}\n\nclass Reservation {\n  - reservationId: String\n  - reservationDate: Date\n  - status: String\n  + cancel(): void\n  + notifyAvailability(): void\n}\n\nclass Fine {\n  - fineId: String\n  - amount: double\n  - paidStatus: boolean\n  + pay(): void\n}\n\nUser &lt;|-- Member\nUser &lt;|-- Librarian\n\nCatalog \&quot;1\&quot; o-- \&quot;many\&quot; Book\nBook \&quot;1\&quot; o-- \&quot;many\&quot; BookCopy\nMember \&quot;1\&quot; --&gt; \&quot;many\&quot; Loan\nBookCopy \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Loan\nLoan \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Fine\nMember \&quot;1\&quot; --&gt; \&quot;many\&quot; Reservation\nBook \&quot;1\&quot; --&gt; \&quot;many\&quot; Reservation\nLibrarian ..&gt; Catalog : manages\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="A4nw-ZAj1Me4aulekQTM-338">
