        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;plantuml\n@startuml ActivityDiagram\ntitle Activity Diagram - Borrow Book Process\n\nstart\n:Member searches for book;\nif (Copy available?) then (yes)\n  if (Member has outstanding fines?) then (yes)\n    :Notify member to clear fines;\n    stop\n  else (no)\n    :Librarian scans book copy;\n    :Create loan record\\n(set due date);\n    :Update book copy status\\nto &#39;On Loan&#39;;\n    :Issue receipt to member;\n    stop\n  endif\nelse (no)\n  :Offer to reserve book;\n  stop\nendif\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="A4nw-ZAj1Me4aulekQTM-509">
